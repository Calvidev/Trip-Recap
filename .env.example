# Required in production: protects the whole app. Also used by the iPhone Shortcut
# as "Authorization: Bearer <APP_TOKEN>". Generate with: openssl rand -hex 24
APP_TOKEN=

# Public URL of your deployment (used for the Gmail OAuth redirect)
APP_URL=http://localhost:3000

# Where the SQLite database lives (mount a persistent volume here)
DATA_DIR=./data

# Gmail import (optional) — Google Cloud OAuth client, type "Web application"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email forwarding (docs/EMAIL_FORWARDING.md): shown in Settings
# INBOUND_EMAIL_ADDRESS=trips@calvi.dev

# Optional: lets Claude read booking emails (and their PDF e-tickets) that have no structured data
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: your own Nominatim server / contact string for OSM's usage policy
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=trip-recap/0.1 (you@example.com)
